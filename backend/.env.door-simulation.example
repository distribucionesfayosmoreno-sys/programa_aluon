## Door Visual Simulation (local/dev2)
#
# Enable module (default true in application-local.yml/application-dev2.yml)
DOOR_SIMULATION_ENABLED=true
DOOR_SIMULATION_OBJECT_STORAGE_ENABLED=false
#
# Google Street View Static API
GOOGLE_STREET_VIEW_API_KEY=
GOOGLE_STREET_VIEW_BASE_URL=https://maps.googleapis.com
#
# Stability AI
STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai
STABILITY_INPAINT_PATH=/v2beta/stable-image/edit/inpaint
STABILITY_OUTPUT_FORMAT=png
#
# Object storage (S3/MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=aluon-door-simulation
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
#
# For public URL generation (recommended to set for MinIO)
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000
DOOR_SIMULATION_LOCAL_BASE_DIR=./door-simulation-assets
